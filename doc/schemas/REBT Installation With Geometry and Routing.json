{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REBT Installation With Geometry and Routing",
  "type": "object",

  "properties": {
    "installation": {
      "type": "object",

      "properties": {
        "rooms": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",
            "required": [
              "id",
              "origin",
              "dimensions",
              "walls",
              "devices"
            ],

            "properties": {
              "id": { "type": "string" },

              "origin": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },

              "dimensions": {
                "type": "object",
                "required": ["width_m", "length_m", "height_m"],
                "properties": {
                  "width_m": { "type": "number", "minimum": 0.5 },
                  "length_m": { "type": "number", "minimum": 0.5 },
                  "height_m": { "type": "number", "minimum": 2.0 }
                }
              },

              "walls": {
                "type": "array",
                "minItems": 1,

                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "start",
                    "end",
                    "thickness_m",
                    "openings"
                  ],

                  "properties": {
                    "id": { "type": "string" },

                    "start": {
                      "type": "array",
                      "items": { "type": "number" },
                      "minItems": 3,
                      "maxItems": 3
                    },

                    "end": {
                      "type": "array",
                      "items": { "type": "number" },
                      "minItems": 3,
                      "maxItems": 3
                    },

                    "thickness_m": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 1.0
                    },

                    "openings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "position",
                          "width_m",
                          "height_m"
                        ],

                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["window", "door"]
                          },

                          "position": {
                            "type": "number",
                            "minimum": 0.0
                          },

                          "width_m": { "type": "number", "minimum": 0.1 },
                          "height_m": { "type": "number", "minimum": 0.1 }
                        }
                      }
                    }
                  }
                }
              },

              "devices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "type", "position"],

                  "properties": {
                    "id": { "type": "string" },

                    "type": {
                      "type": "string",
                      "enum": [
                        "socket",
                        "switch",
                        "light",
                        "junction_box",
                        "distribution_board"
                      ]
                    },

                    "position": {
                      "type": "array",
                      "items": { "type": "number" },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  }
                }
              }
            }
          }
        },

        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "circuit_id",
              "start_device",
              "end_device",
              "segments"
            ],

            "properties": {
              "id": { "type": "string" },
              "circuit_id": { "type": "string" },
              "start_device": { "type": "string" },
              "end_device": { "type": "string" },

              "segments": {
                "type": "array",
                "minItems": 1,

                "items": {
                  "type": "object",
                  "required": ["type", "start", "end"],

                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "wall_chase",
                        "ceiling",
                        "floor",
                        "conduit",
                        "free_air",
                        "vertical_drop",
                        "horizontal_run"
                      ]
                    },

                    "room_id": { "type": "string" },
                    "wall_id": { "type": "string" },

                    "start": {
                      "type": "array",
                      "items": { "type": "number" },
                      "minItems": 3,
                      "maxItems": 3
                    },

                    "end": {
                      "type": "array",
                      "items": { "type": "number" },
                      "minItems": 3,
                      "maxItems": 3
                    },

                    "depth_mm": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 200
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

